# ==============================================================================
# NodeWork Professional Platform – Environment Configuration Reference
# ==============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / React)
# Defined in frontend/.env or Render Static Site Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the API Gateway (without trailing slash)
VITE_API_BASE_URL=https://nodework-api-gateway.onrender.com

# Controls visibility of demo login pills on the Sign In page (true/false)
# Keep false or omitted in production
VITE_DEMO_ENABLED=false

# Cloudinary Unsigned Image Upload Settings
# Create a free account at https://cloudinary.com and configure an unsigned preset
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# LinkedIn OpenID Connect App Client ID
# Obtain from LinkedIn Developer Portal after creating an application
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id


# ─────────────────────────────────────────────────────────────────────────────
# 2. BACKEND GLOBAL ENVIRONMENT VARIABLES
# Configured in render.yaml or Render Web Service Dashboard
# ─────────────────────────────────────────────────────────────────────────────

# Managed PostgreSQL Connection Parameters
DB_HOST=nodework-postgres
DB_PORT=5432
DB_NAME=nodework
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# Authentication & Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
FRONTEND_URL=https://nodework-frontend.onrender.com

# Environment-Controlled Demo Seeding (Set to 'true' only in local/staging)
SEED_DEMO_USERS=false

# Inter-Service Internal/External URLs
USER_SERVICE_URL=https://nodework-user-service.onrender.com
SOCIAL_SERVICE_URL=https://nodework-social-service.onrender.com
POST_SERVICE_URL=https://nodework-post-service.onrender.com
FEED_SERVICE_URL=https://nodework-feed-service.onrender.com


# ─────────────────────────────────────────────────────────────────────────────
# 3. EXTERNAL SERVICE INTEGRATION KEYS
# Add to backend services (post-service and user-service)
# ─────────────────────────────────────────────────────────────────────────────

# Adzuna Jobs API (Backend only: post-service)
# Register for free developer keys at https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Resend Transactional Email API (Backend only: user-service)
# Register at https://resend.com for 3,000 free transactional emails/month
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google OAuth Verification (Backend only: user-service)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# LinkedIn OAuth Verification (Backend only: user-service)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
